# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/finora?schema=public"

# Auth.js / NextAuth configuration
AUTH_SECRET="finora-production-quality-secret-key-at-least-32-chars-long"
NEXTAUTH_SECRET="finora-production-quality-secret-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security & Encryption (AES-256-GCM 32-byte hex for 2FA secrets)
TWO_FACTOR_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Optional OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
